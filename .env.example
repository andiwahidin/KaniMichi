# GEMINI_API_KEY: Optional (if using server-side Gemini features in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected in AI Studio
APP_URL="MY_APP_URL"

# Supabase Configuration (Client-side public keys with Row Level Security)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
