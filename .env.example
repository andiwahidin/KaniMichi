# GEMINI_API_KEY: Optional (if using server-side Gemini features in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Automatically injected in AI Studio
APP_URL="MY_APP_URL"

# Supabase Configuration (Hanya public URL & publishable/anon key — JANGAN gunakan secret key di VITE_!)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API Keys
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only Supabase Secret Key (opsional namun disarankan agar Admin tetap bisa mendaftarkan
# pengguna baru meskipun pendaftaran publik dimatikan di Supabase Dashboard -> Authentication)
supabase_service_role_key=
